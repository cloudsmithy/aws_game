# 复制成 .env 再填（.env 不要提交，已在 .gitignore 里）
# 对外开放：默认 127.0.0.1 只监听本机；给玩家用时改成 0.0.0.0（开之前看 README「对外开放前」）
PUBLIC_BIND=127.0.0.1

# 信令：域名要先解析到这台服务器
PEER_DOMAIN=peer.example.com
ACME_EMAIL=you@example.com
PEER_CONCURRENT_LIMIT=64

# TURN 中继
TURN_REALM=peer.example.com
TURN_PUBLIC_IP=203.0.113.10
TURN_USER=tycoon
# 随机长密码，比如：openssl rand -base64 24
TURN_PASS=
TURN_TOTAL_QUOTA=60
TURN_USER_QUOTA=12
TURN_MAX_BPS=1000000
