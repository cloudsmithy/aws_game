# 信令域名：自动申请、续期 Let's Encrypt 证书；WebSocket（wss://）Caddy 自动转发
{
	email {$ACME_EMAIL}
}

{$PEER_DOMAIN} {
	encode gzip
	# 只转发 PeerJS 用到的路径：/peerjs（WebSocket 信令）和 /peerjs/id 等 HTTP 接口；其余一律 404
	@peer path /peerjs /peerjs/*
	handle @peer {
		reverse_proxy peerjs:9000
	}
	handle {
		respond "Not Found" 404
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}
