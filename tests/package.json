{
  "name": "aws-game",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "cd .. && eslint --config tests/eslint.config.mjs . && stylelint --config tests/stylelint.config.mjs code/index.html && node tests/version.mjs",
    "test:layout": "playwright test",
    "test:content": "playwright test content-layout.spec.mjs",
    "check": "npm run test:version && npm run lint && npm run test:movement && npm run test:auth && npm run test:layout",
    "test:movement": "node --test verification/movement.check.mjs",
    "test:auth": "node --test verification/auth.check.mjs",
    "lint:size": "node size-lint.mjs",
    "lint:version": "node version.mjs",
    "version:stamp": "node version.mjs stamp",
    "test:version": "node --test verification/version.check.mjs",
    "test:ci": "node ci-shard.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "peer": "1.0.2",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0"
  }
}
